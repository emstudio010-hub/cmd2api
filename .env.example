# cmd2api 部署配置
#
# 用法：
#   cp .env.example .env
#   # 填好下面标了「必填」的项
#   docker compose up -d
#
# 生成随机密钥：
#   openssl rand -hex 32     # 用于 ENCRYPTION_KEY
#   openssl rand -hex 24     # 用于 JWT_SECRET / DB_PASSWORD

# ---------- 必填 ----------

# 数据库口令。
DB_PASSWORD=

# 登录令牌的签名密钥。至少 16 字符，建议 48 位十六进制。
JWT_SECRET=

# 上游账号凭证的加密密钥。必须是 64 位十六进制（= 32 字节）。
#
# ⚠️ 这个值一旦丢失，已录入的账号密钥就再也解不出来了，只能重新录入。
# ⚠️ 这个值一旦更换，已录入的账号也会全部失效（同样的原因）。
# 请和数据库备份一起妥善保存。
ENCRYPTION_KEY=

# 初始管理员密码，至少 8 位。
# 只在「系统里一个管理员都没有」时用来创建账号；之后改密码请走后台界面——
# 改这里不会覆盖已经存在的管理员。
BOOTSTRAP_ADMIN_PASSWORD=

# ---------- 选填（多数情况保持默认即可）----------

TZ=Asia/Shanghai
LOG_LEVEL=info

DB_USER=cmd2api
DB_NAME=cmd2api
BOOTSTRAP_ADMIN_EMAIL=admin@cmd2api.local

# 登录令牌有效期。
JWT_TTL=24h

# 对外监听。默认只绑回环，前面应放 nginx/caddy 处理 TLS。
# 想直接对外暴露就改成 BIND_ADDR=0.0.0.0（但流量是明文的，不建议）。
BIND_ADDR=127.0.0.1
HOST_PORT=8080

# ---------- Command Code 上游 ----------

CC_API_BASE=https://api.commandcode.ai

# 访问上游时走的 HTTP 代理，留空表示直连。
#
# 服务器在国内、或上游需要特定出口时用它，例如 http://127.0.0.1:7890。
# 只支持 http:// 和 https:// 代理；socks5 暂不支持。
#
# 注意：Docker 部署时容器里的 127.0.0.1 指的是容器自己。
# 要访问跑在宿主机上的代理，填 host.docker.internal:端口
# （compose 已经加好了 extra_hosts 映射，Linux 上也能用）。
CC_UPSTREAM_PROXY=

# 设备指纹的盐。留空即可。
#
# 作用：设备指纹是由账号密钥确定性地派生出来的，保证同一个账号永远上报
# 同一台"设备"。极少数情况下（例如上游把这个设备标记了）可以改这个值，
# 让所有账号一起换一台新设备——这是唯一的逃生口。
#
# ⚠️ 改动它等于让全部账号在同一时刻换设备，这本身是个明显信号。
# 只在确实需要时改，改完就留着别动。
CC_FINGERPRINT_SALT=

# 请求不带 system 提示词时，发一个空格占位，阻止上游注入它自带的
# 约 7.5K token 默认提示词（那既产生大量缓存 token 又污染对话）。
# 除非你明确想要上游的默认行为，否则保持 true。
CC_EMPTY_SYSTEM_PLACEHOLDER=true

# 流式 / 非流式响应读取上游的空闲超时。上游卡住超过这个时间就断开。
CC_STREAM_IDLE=30s
CC_NONSTREAM_IDLE=90s

# 请求体大小上限（MB）。客户端发大量图片时可能需要调大。
CC_MAX_BODY_MB=100

# ---------- 账号健康检查 ----------

# 周期性地用极小的请求探测每个账号是否真的能用。
# 代价是每轮每个账号消耗几十个 token，换来的是账号失效能被自动发现。
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=10m

# 连续失败多少次后自动禁用账号。
HEALTH_FAILURE_THRESHOLD=5
